# Copy to .env (never commit .env)
POSTGRES_PASSWORD=lws
SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false
REQUIRE_VERIFIED_EMAIL=false

# Google sign-in: create an OAuth client at console.cloud.google.com
# Authorized redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email (password-reset and verification links). Any SMTP service works: Amazon SES SMTP, Zoho, Brevo, Gmail app password...
# Leave SMTP_HOST empty in development: emails are only logged, and the "Forgot password?" link stays hidden.
# Port 587 uses STARTTLS; port 465 uses implicit TLS. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Learn With Sateesh <no-reply@learnwithsateesh.in>
